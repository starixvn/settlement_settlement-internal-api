<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AutoMapper" Version="13.0.1" />
    <PackageReference Include="Fanex.Caching.Redis" Version="2.2.7" />
    <PackageReference Include="Fanex.Caching.Redis.AspNetCore" Version="2.2.5" />
    <PackageReference Include="Fanex.Data" Version="4.3.2" />
    <PackageReference Include="Fanex.Data.Repository" Version="4.3.2" />
    <PackageReference Include="Fanex.Data.SqlServer" Version="4.3.2" />
    <PackageReference Include="Fanex.Logging" Version="2.0.2" />
    <PackageReference Include="Fanex.Logging.Extensions.AspNetCore" Version="1.1.0" />
    <PackageReference Include="Fanex.Logging.Extensions.Database" Version="1.1.0" />
    <PackageReference Include="Fanex.Logging.Sentry.RavenClient" Version="2.0.2" />
    <PackageReference Include="Fanex.Settlement.Business" Version="1.0.23" />
    <PackageReference Include="MinimalApi.Endpoint" Version="1.3.0" />
    <PackageReference Include="ONEbook.UM" Version="3.1.8" />
    <PackageReference Include="Polly" Version="8.5.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Settlement.EventManagement\Settlement.EventManagement.csproj" />
    <ProjectReference Include="..\Settlement.Gaming\Settlement.Gaming.csproj" />
    <ProjectReference Include="..\Settlement.Internal\Settlement.Internal.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="appsettings.PROD.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Update="appsettings.UAT.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Update="appsettings.SIT.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Update="appsettings.LOCAL.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Update="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <None Update="App_Data\SpName.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>